{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".npmrc", "pnpm-lock.yaml", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV", "GIT_SHA"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
