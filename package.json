{
  "name": "showcase",
  "private": true,
  "description": "Student Showcase monorepo for Admin, Student, Visitor, and Core applications",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.18.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && node tools/bootstrap.mjs",
    "build": "turbo run build",
    "db:lint": "supabase db lint --local",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:ci"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "turbo": "2.10.11"
  }
}
