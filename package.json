{
  "name": "showcase",
  "private": true,
  "description": "Student Showcase monorepo for Admin, Student, Visitor, and Core applications",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.18.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && node tools/bootstrap.mjs",
    "build": "turbo run build",
    "db:lint": "supabase db lint --local",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "dev": "turbo run dev",
    "e2e": "node --experimental-strip-types tools/playwright/run.ts",
    "e2e:headed": "node --experimental-strip-types tools/playwright/run.ts --headed",
    "e2e:debug": "node --experimental-strip-types tools/playwright/run.ts --debug",
    "e2e:unit": "node --experimental-strip-types --test tools/playwright/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "skills:check": "node tools/validate-skills.mjs",
    "skills:test": "node --test tools/validate-skills.test.mjs",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "check": "pnpm format:check && pnpm skills:check && pnpm skills:test && pnpm lint && pnpm typecheck && pnpm test:ci"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.43",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "turbo": "2.10.11",
    "yaml": "2.9.0"
  }
}
